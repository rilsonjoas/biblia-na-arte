{
  "name": "biblia-na-arte",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev:web": "pnpm --filter web dev",
    "dev:server": "pnpm --filter server dev",
    "build:web": "pnpm --filter web build",
    "build:server": "pnpm --filter server build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:integration": "pnpm --filter server test:integration",
    "prepare": "(husky || true) && (git lfs install --force || true)"
  },
  "engines": {
    "node": ">=20"
  },
  "lint-staged": {
    "server/**/*.ts": "pnpm --filter server exec eslint --fix",
    "web/**/*.{ts,tsx}": "pnpm --filter web exec eslint --fix"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0"
  },
  "pnpm": {
    "overrides": {
      "fast-uri": ">=4.1.3"
    }
  }
}
