# Copiar pra .env (nunca commitar o .env real).

NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Postgres compartilhado do VPS. Historicamente um usuário só de SELECT
# (v1 era somente leitura pública) — desde a submissão de artistas
# (roadmap, 2026-09-05) precisa também de INSERT/UPDATE em `submissions`,
# `users`, `artworks` e `bible_references`. Ver docs/ROADMAP.md antes de
# trocar a permissão em produção.
DATABASE_URL=postgresql://usuario:senha@localhost:5432/biblia_na_arte_db

# Domínio(s) real(is) do frontend em produção — nunca "*". Lista separada
# por vírgula quando mais de um site consome a API direto do navegador
# (ex.: o site oficial + outros projetos da "Biblioteca", como o Lecionário).
CORS_ORIGIN=https://biblianaarte.narniano.com,https://lecionario.narniano.com

RATE_LIMIT_MAX=200
RATE_LIMIT_WINDOW_MS=60000

# Painel administrativo / submissão de artistas (roadmap, 2026-09-05).
# Gerar com `openssl rand -hex 32` — nunca reaproveitar entre ambientes.
JWT_SECRET=

# Onde imagens de submissões pendentes ficam salvas antes de aprovadas
# (fora de web/public/images, não servido publicamente). No VPS, precisa
# ser um caminho persistente entre deploys (volume Docker), não um
# diretório efêmero do container.
SUBMISSION_UPLOADS_DIR=./uploads/pending-submissions

# Onde a imagem fica depois de aprovada — precisa ser um volume Docker
# persistente também (mesmo motivo do de cima). `web` é build estático
# (nginx, Dockerfile copia web/dist pronto) — não tem como escrever
# imagem de submissão lá, por isso a própria API serve essa pasta.
APPROVED_SUBMISSION_UPLOADS_DIR=./uploads/approved-submissions

# URL pública desta API — precisa ser absoluta (domínio real em
# produção), usada só pra montar o link de imagem de obras de submissão.
PUBLIC_API_URL=https://api-biblianaarte.narniano.com

# URL pública do `web` (nginx, domínio diferente da API) — usada só pela
# rota /artworks/:id/social-image pra buscar a imagem original do vault.
WEB_PUBLIC_URL=https://biblianaarte.narniano.com
