# Copiar pra .env (nunca commitar o .env real).

NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Postgres compartilhado do VPS — usar um usuário com permissão só de
# SELECT no biblia_na_arte_db (v1 é somente leitura pública).
DATABASE_URL=postgresql://usuario:senha@localhost:5432/biblia_na_arte_db

# Domínio real do frontend em produção — nunca "*".
CORS_ORIGIN=http://localhost:8080

RATE_LIMIT_MAX=200
RATE_LIMIT_WINDOW_MS=60000
