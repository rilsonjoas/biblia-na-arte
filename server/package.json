{
  "name": "server",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:integration:setup": "docker compose -f docker-compose.test.yml up -d",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "export:vault": "tsx scripts/export-vault-data.ts",
    "db:seed": "tsx scripts/import-seed-data.ts",
    "images:optimize": "tsx scripts/optimize-images.ts",
    "sitemap:generate": "tsx scripts/generate-sitemap.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^12.0.1",
    "@fastify/rate-limit": "^10.1.1",
    "@fastify/swagger": "^9.8.1",
    "@sentry/node": "^10.69.0",
    "dotenv": "^17.2.1",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.1.0",
    "fastify-plugin": "^6.0.0",
    "pino-pretty": "^11.3.0",
    "postgres": "^3.4.5",
    "yaml": "^2.6.1",
    "zod": "^3.23.8",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@types/node": "^22.9.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.32.0",
    "globals": "^15.15.0",
    "sharp": "^0.35.3",
    "tsx": "^4.20.5",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=20"
  }
}
